    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text;\n\n\nconst fileName = $(\"Edit Fields\").first().json.fileName;\n\n// Configuration\nconst chunkSize = 1000;\nconst overlap = 200;\n\nlet chunks = [];\nlet start = 0;\nlet chunkNumber = 1;\n\n// Clean the extracted text\nconst cleanText = text.replace(/\\s+/g, \" \").trim();\n\nwhile (start < cleanText.length) {\n\n    const end = Math.min(start + chunkSize, cleanText.length);\n\n    const chunk = cleanText.substring(start, end);\n\n    chunks.push({\n        json: {\n            id: `${fileName}_${chunkNumber}`,\n            content: chunk,\n            metadata: {\n                document: fileName,\n                chunk: chunkNumber\n            }\n        }\n    });\n\n    start += chunkSize - overlap;\n    chunkNumber++;\n}\n\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
